{
  "name": "tk-studio-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The studio web (D5, design spec §6.3): Vite plus React plus TypeScript, one PixiJS v8 canvas, built to static files in dist/.",
  "scripts": {
    "dev": "bun x vite",
    "build": "bun x vite build",
    "test": "bun x vitest run",
    "verify": "bun install --frozen-lockfile && bun run build && bun run test",
    "sprites": "uv run --no-project python ../../tools/sprites/export.py"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
