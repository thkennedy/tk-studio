+  const story = h("story", live.story);
+  const stage = h("stage", live.stage);
+  const findings = h("findings", live.bar.findings.label);
+  const guard = h("guard", live.clock ? { mode: live.clock.mode, guard_s: live.clock.guard_s, context: live.clock.context } : null);
+  let clockText = live.clockText;
+  let over = false;
+  if (live.clock && guard) {
+    const elapsed = t("elapsed", h("elapsed_raw", live.clock.elapsed_s));
+    clockText = clockLabel(guard.mode, elapsed, guard.guard_s);
+    over = guard.guard_s !== null && Math.floor(elapsed) > guard.guard_s;
+  }
+  const fraction = t("fraction", h("fraction_raw", live.bar.fraction));
+  const phases = live.bar.phases.map((p) => {
+    const status = h(`phase:${p.key}`, p.status);
+    return { key: p.key, status, fill: t(`fill:${p.key}`, FILL[status] ?? 0) };
+  });
+  const moving = Object.values(tweens).some((tw) => inFlight(tw, now));
+  return {
+    motion: { held, tweens },
+    shown: { run_id, story, stage, findings, clockText, clockContext: guard ? guard.context : null, over, fraction, phases, moving },
+  };
+}
